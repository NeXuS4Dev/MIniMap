<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Package restores need both feeds:
    - nuget.org          -> Newtonsoft.Json (transitive), Unity.Netcode bits in GameLibs, etc.
    - nuget.bepinex.dev  -> BepInEx.Core and UnityEngine.Modules 2022.3.6x
                            (neither is published on nuget.org)
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="BepInEx" value="https://nuget.bepinex.dev/v3/index.json" />
  </packageSources>
</configuration>
