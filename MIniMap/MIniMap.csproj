<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>MIniMap</AssemblyName>
    <RootNamespace>MIniMap</RootNamespace>
    <Version>1.2.0</Version>
    <AssemblyVersion>1.2.0.0</AssemblyVersion>
    <FileVersion>1.2.0.0</FileVersion>
    <InformationalVersion>1.2.0</InformationalVersion>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyTitle>MIniMap</AssemblyTitle>
    <Description>Minimalistic client-side minimap mod for Lethal Company (v81+)</Description>
    <Company>Diman3012</Company>
    <Product>MIniMap</Product>
    <Copyright>Copyright © Diman3012 2026</Copyright>
    <Deterministic>true</Deterministic>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <!--
    References come from NuGet, no local Lethal Company install is required.

    LethalCompany.GameLibs.Steam = stripped & publicized v81 game assemblies.
    ExcludeAssets=runtime keeps all game/BepInEx DLLs out of the build output;
    BepInEx provides the real ones when the game runs.
  -->
  <ItemGroup>
    <PackageReference Include="BepInEx.Core" Version="5.4.21" ExcludeAssets="runtime" />
    <PackageReference Include="LethalCompany.GameLibs.Steam" Version="81.0.5-ngd.0" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
